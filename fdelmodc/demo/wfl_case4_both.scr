#!/bin/bash
# Case 4: both   (wfl_tshift=1 wfl_corner2=1, timing shift + repeated corner points)
# Self-contained: builds model/wavelets, runs forward + reconstruction, shows snapshots and the
# point-receiver comparison. Outputs in demo/wfl_cases/both/.
# Options: BWD=0 VIEW=0 SNAPFIELDS="vx vz txz" CLIPFRAC=0.1 ./wfl_case4_both.scr
exec "$(dirname "$0")/wfl_case.sh" both 1 1
