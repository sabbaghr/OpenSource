# Hydrophone P = 0.5*(Txx+Tzz): shot1 at OBC vs shot4 at surface
suop2 test_shot_obc_Psour_rtxx.su test_shot_obc_Psour_rtzz.su op=sum | sugain scale=0.5 > test_shot_obc_Psour_rp.su
suop2 test_shot_obc_Psour_OBC_rtxx.su test_shot_obc_Psour_OBC_rtzz.su op=sum | sugain scale=0.5 > test_shot_obc_Psour_OBC_rp.su

# P-P reciprocity: hydrophone at OBC (P src at surface) vs hydrophone at surface (P src at OBC)
(suwind key=gx min=1500000 max=1500000 < test_shot_obc_Psour_rp.su ; suwind key=gx min=2500000 max=2500000 < test_shot_obc_Psour_OBC_rp.su) | suxgraph title="P-P reciprocity: hydrophone" & 




