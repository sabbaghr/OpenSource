#!/bin/bash
# Layered model (water + 2 elastic layers, free surface). Case 1: original   (wfl_tshift=0 wfl_corner2=0, original contour and timing)
# Self-contained: builds the model and wavelets, runs forward + reconstruction, shows snapshots and the
# point-receiver comparison (water / layer 1 / layer 2). Outputs in demo/wfl_cases_layered/original/.
# Parameters: wfl_params_layered.sh.  Options: BND_TOP_RECON=2 BWD=0 VIEW=0 SNAPFIELDS="vx vz" PLOTCOMPS="vz tzz" ./wfl_layered1_original.scr
export WFL_PARAMS="$(cd "$(dirname "$0")" && pwd)/wfl_params_layered.sh"
exec "$(dirname "$0")/wfl_case.sh" original 0 0
